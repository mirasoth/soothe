/* Deep Agents CLI Textual Stylesheet */

/* Define layers for z-ordering */
Screen {
    layout: vertical;
    layers: base autocomplete;
}

/* Scrollable regions keep wheel / key scrolling; scrollbar chrome is hidden. */
* {
    scrollbar-visibility: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $foreground-muted;
    scrollbar-color-hover: $text-muted;
    scrollbar-color-active: $primary-muted;
    scrollbar-corner-color: $background;
}

/* Main content goes on base layer by default */

/* Chat area - main scrollable messages area */
#chat {
    height: 1fr;
    padding: 0 1;
    background: $background;
}

/* Fills at least the scroll viewport; bottom-aligns welcome + messages when the
   thread is short so dead space sits above the banner instead of above the input. */
#chat-body {
    width: 1fr;
    min-height: 100%;
    height: auto;
    layout: vertical;
    align-vertical: bottom;
}

/* Welcome banner */
#welcome-banner {
    height: auto;
    margin-bottom: 0;
}

/* Messages area — uses undocumented "stream" layout (Textual ≥5.2.0) for
   O(1) append performance via incremental placement caching. */
#messages {
    layout: stream;
    height: auto;
    margin-top: 0;
    padding-top: 0;
}

/* Sticky bottom chrome — thinking row, ChatInput, and status bar.
   Docked so Screen scroll (e.g. ChatInput.scroll_visible) cannot clip the
   thinking row above the input. Plan quick-view is a non-docked sibling
   above this container so expanding it shrinks #chat instead of covering
   the chrome. */
#bottom-app-container {
    dock: bottom;
    height: auto;
    width: 100%;
    max-height: 100%;
    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1;
}

/* Sticky thinking row directly above input box */
#thinking-status {
    height: auto;
    min-height: 0;
    margin-bottom: 0;
}

/* Input area */
#input-area {
    height: auto;
    min-height: 3;
    max-height: 25;
}

/* Status bar lives inside #bottom-app-container — share its padding only. */
#status-bar {
    height: 1;
    padding: 0;
}

#status-bar ClarificationModeBadge {
    margin-left: 1;
    margin-right: 1;
}

/* Non-blocking filesystem change previews (write / edit / delete) */
.file-change-preview {
    height: auto;
}

.file-change-preview-header {
    height: auto;
    margin: 0;
}

.file-change-preview-body {
    color: $text-muted;
    margin: 0;
}

.file-change-preview-section-label {
    height: auto;
    margin: 0;
}

.file-change-preview .diff-line-added,
.file-change-preview .diff-line-removed,
.file-change-preview .diff-context {
    height: auto;
    margin: 0;
    padding: 0;
}

.file-change-preview .diff-context {
    color: $text-muted;
}

/* Diff styling — previews and DiffMessage (fg + bg + padding) */
.diff-context {
    height: auto;
    color: $text-muted;
    padding: 0;
    margin: 0;
}

/* Diff line backgrounds — used by compose_diff_lines (bg only, fg via Content) */
.diff-line-removed {
    background: $error-muted;
}

.diff-line-added {
    background: $success-muted;
}

/* Mode-specific borders for UserMessage */
UserMessage.-mode-shell {
    border: solid $mode-bash;
}

UserMessage.-mode-command {
    border: solid $mode-command;
}

/* ASCII border overrides */
UserMessage.-ascii {
    border: ascii $primary;
}

UserMessage.-ascii.-mode-shell {
    border: ascii $mode-bash;
}

UserMessage.-ascii.-mode-command {
    border: ascii $mode-command;
}

QueuedUserMessage.-ascii {
    border: ascii $panel;
}

/* ChatTextArea: override TextArea's built-in $surface background */
ChatTextArea {
    background: transparent;

    & .text-area--cursor-line {
        background: transparent;
    }

    & .text-area--cursor-gutter {
        background: transparent;
    }
}

/* Completion popup styling (used by ChatInput) - appears ABOVE input */
#completion-popup {
    height: auto;
    max-height: 12;
    width: 100%;
    margin-left: 3;
    margin-bottom: 0;
    border-bottom: solid $foreground-muted;
    padding: 0;
    color: $text;
}
