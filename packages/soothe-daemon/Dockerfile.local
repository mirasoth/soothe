# Soothe daemon — local source build (sdk from submodule; nano/deepagents from PyPI).
#
# Build context must be the monorepo root (parent of `packages/`). Installs from
# local source: packages/soothe-sdk, packages/soothe, packages/soothe-daemon.
# ``soothe-nano`` and ``soothe-deepagents`` are pulled from PyPI.
#
# Build (full image with browser subagent):
#   docker build -f packages/soothe-daemon/Dockerfile.local \
#     --build-arg INCLUDE_BROWSER=true \
#     -t soothed:local .
#
# Build (slim image without browser subagent):
#   docker build -f packages/soothe-daemon/Dockerfile.local \
#     --build-arg INCLUDE_BROWSER=false \
#     -t soothed:local-slim .
#
# Run (unified listener on 8765: WebSocket + REST):
#   docker run --rm -p 8765:8765 \
#     -e OPENAI_API_KEY=... \
#     -v soothe-data:/var/lib/soothe \
#     soothed:local

ARG PYTHON_BASE=registry.cn-hangzhou.aliyuncs.com/lacogito/python:3.12-bookworm

# =============================================================================
# Stage 1: install from local source + browsers (optional)
# =============================================================================
FROM ${PYTHON_BASE} AS deps

ARG INCLUDE_BROWSER=true

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    SOOTHE_HOME=/var/lib/soothe

RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv directly via curl (avoids ghcr.io access for networks with restrictions)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv

# Ensure playwright browsers directory exists (empty if INCLUDE_BROWSER=false)
RUN mkdir -p /opt/ms-playwright

# Copy only metadata first so dependency layer remains cacheable across source edits.
COPY VERSION /app/VERSION
COPY packages/soothe-sdk/pyproject.toml /app/packages/soothe-sdk/pyproject.toml
COPY packages/soothe-sdk/README.md /app/packages/soothe-sdk/README.md
COPY packages/soothe/pyproject.toml /app/packages/soothe/pyproject.toml
COPY packages/soothe/README.md /app/packages/soothe/README.md
COPY packages/soothe-daemon/pyproject.toml /app/packages/soothe-daemon/pyproject.toml
COPY packages/soothe-daemon/README.md /app/packages/soothe-daemon/README.md
COPY scripts/build_runtime_requirements.py /app/scripts/build_runtime_requirements.py

RUN --mount=type=cache,target=/root/.cache/uv \
    set -eux; \
    if [ "${INCLUDE_BROWSER}" = "true" ]; then browser_arg="--include-browser"; else browser_arg=""; fi; \
    python /app/scripts/build_runtime_requirements.py --app-root /app ${browser_arg} --output /tmp/requirements.runtime.txt; \
    uv venv /app/.venv; \
    uv pip install --python /app/.venv/bin/python -r /tmp/requirements.runtime.txt; \
    rm -f /tmp/requirements.runtime.txt

# Copy local packages after third-party + PyPI nano/deepagents deps are cached.
COPY packages/soothe-sdk /app/packages/soothe-sdk
COPY packages/soothe /app/packages/soothe
COPY packages/soothe-daemon /app/packages/soothe-daemon

RUN --mount=type=cache,target=/root/.cache/uv \
    set -eux; \
    uv pip install --python /app/.venv/bin/python \
        --no-deps \
        "/app/packages/soothe-sdk" \
        "/app/packages/soothe" \
        "/app/packages/soothe-daemon"; \
    if [ "${INCLUDE_BROWSER}" = "true" ]; then \
      /app/.venv/bin/python -m playwright install chromium; \
    fi

ENV PATH="/app/.venv/bin:${PATH}"

# =============================================================================
# Stage 2: minimal runtime (venv + browsers + jemalloc, non-root)
# =============================================================================
FROM ${PYTHON_BASE} AS runtime

ARG INCLUDE_BROWSER=true

LABEL org.opencontainers.image.title="Soothe Daemon (Local Build)" \
    org.opencontainers.image.description="Soothe agent orchestration daemon built from local source" \
    org.opencontainers.image.source="https://github.com/OpenSoothe/soothe"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILEBYTECODE=1 \
    SOOTHE_HOME=/var/lib/soothe \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    SOOTHE_DAEMON_TRANSPORTS__WEBSOCKET__HOST=0.0.0.0 \
    SOOTHE_DAEMON_TRANSPORTS__HTTP_REST__ENABLED=true \
    SOOTHE_DAEMON_TRANSPORTS__HTTP_REST__HOST=0.0.0.0

WORKDIR /app

COPY --from=deps /app/.venv /app/.venv
COPY --from=deps /opt/ms-playwright /opt/ms-playwright

ENV PATH="/app/.venv/bin:${PATH}"

# Install runtime deps: playwright browser libs (if needed) + jemalloc for memory optimization
RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && if [ "${INCLUDE_BROWSER}" = "true" ] && [ -n "$(ls -A /opt/ms-playwright 2>/dev/null)" ]; then \
      /app/.venv/bin/python -m playwright install-deps; \
    fi \
    && apt-get install -y --no-install-recommends libjemalloc2 ripgrep silversearcher-ag \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --system soothe \
    && mkdir -p /var/lib/soothe \
    && chown -R soothe:soothe /var/lib/soothe /opt/ms-playwright

USER soothe
WORKDIR /var/lib/soothe

EXPOSE 8765/tcp

# HTTP healthcheck via /healthz endpoint (more reliable than socket probe)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=3)" || exit 1

CMD ["python", "-m", "soothe_daemon"]
