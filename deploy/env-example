# Soothe Production Environment Variables
# DashScope wired into the OpenAI-compatible env vars consumed by
# deploy/docker-compose.yml and config/production/nano.yml.
# Values come from the host shell environment (export before running).

OPENAI_BASE_URL=${DASHSCOPE_BASE_URL}
OPENAI_API_KEY=${DASHSCOPE_API_KEY}

# Tavily web search for deep_research / wizsearch (https://tavily.com)
TAVILY_API_KEY=${TAVILY_API_KEY}

# Enable verbose agent and file logging in the daemon (SOOTHE_DEBUG → config debug: true).
SOOTHE_DEBUG=false
