# Soothe production env vars. Auto-imported into soothed via env_file.
# Values use ${VAR} substitution from the host shell.
OPENAI_BASE_URL=${DASHSCOPE_BASE_URL}
OPENAI_API_KEY=${DASHSCOPE_API_KEY}
TAVILY_API_KEY=${TAVILY_API_KEY}
TYPESAFE_API_KEY=${TYPESAFE_API_KEY}
SOOTHE_DEBUG=false

# External S3 service for workspace sync (nano.yml workspace_sync).
# Required only when loops use s3:// workspaces (or workspace_sync.enabled).
# endpoint_url: S3-compatible endpoint (COS/MinIO/...). For AWS-native S3,
# remove endpoint_url and use profile/IAM credentials instead.
SOOTHE_SYNC_ENDPOINT_URL=${SOOTHE_SYNC_ENDPOINT_URL}
SOOTHE_SYNC_ACCESS_KEY=${SOOTHE_SYNC_ACCESS_KEY}
SOOTHE_SYNC_SECRET_KEY=${SOOTHE_SYNC_SECRET_KEY}
SOOTHE_SYNC_BUCKET=${SOOTHE_SYNC_BUCKET}
SOOTHE_SYNC_PREFIX=${SOOTHE_SYNC_PREFIX}