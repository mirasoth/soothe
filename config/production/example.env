# Soothe production env vars. Auto-imported into soothed via env_file.
# Values use ${VAR} substitution from the host shell.

OPENAI_BASE_URL=${DASHSCOPE_BASE_URL}
OPENAI_API_KEY=${DASHSCOPE_API_KEY}

# Multi-instance DashScope providers (ds2/ds4/ds5/ds6/ds7/ds9/ds10 in nano.yml)
DS2_BASE_URL=${DS2_BASE_URL}
DS2_API_KEY=${DS2_API_KEY}
DS4_BASE_URL=${DS4_BASE_URL}
DS4_API_KEY=${DS4_API_KEY}
DS5_BASE_URL=${DS5_BASE_URL}
DS5_API_KEY=${DS5_API_KEY}
DS6_BASE_URL=${DS6_BASE_URL}
DS6_API_KEY=${DS6_API_KEY}
DS7_BASE_URL=${DS7_BASE_URL}
DS7_API_KEY=${DS7_API_KEY}
DS9_BASE_URL=${DS9_BASE_URL}
DS9_API_KEY=${DS9_API_KEY}
DS10_BASE_URL=${DS10_BASE_URL}
DS10_API_KEY=${DS10_API_KEY}

TAVILY_API_KEY=${TAVILY_API_KEY}
SOOTHE_DEBUG=false
