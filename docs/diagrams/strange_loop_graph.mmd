---
title: StrangeLoop LangGraph (RFC-904)
config:
  flowchart:
    curve: basis
    nodeSpacing: 30
    rankSpacing: 40
    useMaxWidth: true
  theme: base
  themeVariables:
    primaryColor: "#e1f5fe"
    primaryTextColor: "#01579b"
    primaryBorderColor: "#0288d1"
    lineColor: "#0288d1"
    secondaryColor: "#fff3e0"
    tertiaryColor: "#f3e5f5"
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	enter_loop(enter_loop)
	delegate(delegate)
	dispatch(dispatch)
	execute(execute)
	record_progress(record_progress)
	reconcile(reconcile)
	root_eval(root_eval)
	await_user(await_user)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	intake --> enter_loop;
	enter_loop -.-> delegate;
	enter_loop -.-> dispatch;
	enter_loop -.-> __end__;
	delegate -.-> dispatch;
	delegate -.-> await_user;
	delegate -.-> finalize;
	delegate -.-> __end__;
	dispatch -.-> execute;
	dispatch -.-> root_eval;
	dispatch -.-> __end__;
	execute -.-> record_progress;
	execute -.-> await_user;
	execute -.-> __end__;
	record_progress -.-> reconcile;
	record_progress -.-> finalize;
	record_progress -.-> __end__;
	reconcile -.-> dispatch;
	reconcile -.-> root_eval;
	root_eval -.-> dispatch;
	root_eval -.-> finalize;
	await_user -.-> delegate;
	await_user -.-> dispatch;
	await_user -.-> execute;
	await_user -.-> __end__;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
	linkStyle 4,8,11,14,17,25 stroke:#b0bec5,stroke-width:1px
	linkStyle 26 stroke:#0288d1,stroke-width:2px
